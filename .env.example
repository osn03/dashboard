# Copy is automatic: run `npm run setup` to create .env with fresh random secrets.
# Never commit .env. Never paste these values into chat tools.

# --- Core ---
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/dashboard.db
# 32 random bytes, base64. Encrypts stored integration tokens (AES-256-GCM).
APP_ENCRYPTION_KEY=replace-with-output-of-npm-run-setup
# Set to "true" only when serving over HTTPS (adds the Secure cookie flag).
COOKIE_SECURE=false

# --- Google Calendar (optional; see README "Connect Google Calendar") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/callback
# PKCE is sent on top of the client secret. Set to false only if Google rejects the sign-in request.
GOOGLE_PKCE=true
# Minutes between automatic background syncs.
GOOGLE_SYNC_MINUTES=5

# --- Intervals.icu (optional, read-only; see README "Connect Intervals.icu") ---
# Athlete ID looks like i12345. Both values are on intervals.icu -> Settings -> Developer Settings.
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=
INTERVALS_SYNC_MINUTES=30

# --- Assistant ---
# Default: your locally installed Claude Code with your Claude subscription. It needs NO key
# here - sign in once with `claude auth login` in a terminal. See README "Set up the assistant".
# Optional: full path to claude.exe if it is not found automatically.
CLAUDE_CODE_PATH=
# Seconds before a single assistant request is stopped.
CLAUDE_CODE_TIMEOUT_SECONDS=240

# --- Claude API (optional, pay-per-use; only used if you select it in Settings) ---
# This key is never passed to Claude Code and never used as a fallback for the subscription assistant.
ANTHROPIC_API_KEY=
# Leave empty for the default (claude-opus-5-5). Cheaper: claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_MODEL=

# --- ChatGPT assistant (optional, pay-per-use; only used if you select it in Settings) ---
# API key from https://platform.openai.com/api-keys (billed per use, separately from a ChatGPT subscription).
OPENAI_API_KEY=
# Leave empty for the default (gpt-6.1-sol). More capable: gpt-6-astra. Cheapest: gpt-6-luna.
OPENAI_MODEL=
